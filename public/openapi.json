              ]
            }
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Resultado JSON; fotos como bytes privados"
          },
          "201": {
            "description": "Creación persistida"
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Origen o protección inválidos"
          },
          "404": {
            "description": "No disponible o credencial incorrecta"
          },
          "409": {
            "description": "Conflicto o límite de adjuntos"
          },
          "413": {
            "description": "Límite de bytes"
          },
          "429": {
            "description": "Cuota temporal"
