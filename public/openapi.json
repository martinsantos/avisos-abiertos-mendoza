    "/notices": {
      "post": {
        "summary": "Crear; bearer de sesión y credencial del aviso generada por el cliente",
        "parameters": [
          {
            "name": "X-Avisos-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "place",
                  "department",
                  "description",
                  "occurredAt",
                  "credential",
                  "idempotencyKey"
                ],
                "properties": {
                  "place": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "department": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "occurredAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "credential": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "location": {
                    "type": "object",
                    "required": [
                      "latitude",
                      "longitude",
                      "accuracy"
                    ],
                    "properties": {
                      "latitude": {
                        "type": "number"
                      },
                      "longitude": {
                        "type": "number"
                      },
                      "accuracy": {
                        "type": "number",
                        "description": "Precisión en metros"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado JSON; fotos como bytes privados"
          },
          "201": {
            "description": "Creación persistida"
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sesión inválida"
          },
          "403": {
            "description": "Origen o protección inválidos"
          },
          "404": {
            "description": "No disponible o credencial incorrecta"
          },
          "409": {
            "description": "Conflicto o límite de adjuntos"
          },
          "413": {
            "description": "Límite de bytes"
          },
          "429": {
            "description": "Cuota temporal"
          },
          "503": {
            "description": "Almacenamiento no disponible"
          }
        }
      }
    },
